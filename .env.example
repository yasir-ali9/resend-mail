DATABASE_URL="" # Required - PostgreSQL connection string (Neon works).
PASSWORD="" # Required - Password used to unlock this installation.
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="" # Required - A long random value used to sign login sessions.
